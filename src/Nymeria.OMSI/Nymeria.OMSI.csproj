<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Nymeria.Omsi</RootNamespace>
    <AssemblyName>Nymeria.OMSI</AssemblyName>
  </PropertyGroup>

  <!--
    The engine is consumed as a pinned Git submodule (see docs/ARCHITECTURE.md).
    These project references are the only engine dependency. The submodule is
    read-only from this repository's perspective: never edit files under
    external/Nymeria, and never add engine source to src/.
  -->
  <ItemGroup>
    <ProjectReference Include="../../external/Nymeria/src/platform/Nymeria.Platform/Nymeria.Platform.csproj" />
    <ProjectReference Include="../../external/Nymeria/src/graphics/Nymeria.Graphics/Nymeria.Graphics.csproj" />
    <!--
      Scenery loading reuses the engine's own format decoders rather than
      implementing an asset pipeline here: the .o3d and DirectX .x model parsers
      and the texture loader that dispatches to the engine's image decoders.
      These are the same pinned engine projects its own examples reference.
    -->
    <ProjectReference Include="../../external/Nymeria/src/core/Nymeria.Core/Nymeria.Core.csproj" />
    <ProjectReference Include="../../external/Nymeria/src/formats/Nymeria.Formats.O3d/Nymeria.Formats.O3d.csproj" />
    <ProjectReference Include="../../external/Nymeria/src/formats/Nymeria.Formats.DirectX/Nymeria.Formats.DirectX.csproj" />
    <ProjectReference Include="../../external/Nymeria/src/formats/Nymeria.Formats.Textures/Nymeria.Formats.Textures.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Host options are GPU-free, so their parsing is unit-tested without SDL. -->
    <InternalsVisibleTo Include="Nymeria.OMSI.Tests" />
  </ItemGroup>

  <!--
    Terrain shaders. The Metal source is embedded as-is and compiled by SDL when the
    shaders are created. Direct3D 12 needs DXIL bytecode, which is generated from the
    HLSL source by the DirectX Shader Compiler during a Windows build and embedded
    below; Shaders/DxilShaders.targets performs that step. Neither form is used in
    place of the other, and macOS never runs a shader compiler.
  -->
  <PropertyGroup>
    <OmsiDxilOutputDirectory>$([System.IO.Path]::Combine('$(BaseIntermediateOutputPath)', 'dxil'))</OmsiDxilOutputDirectory>
    <OmsiDxilEnabled Condition="'$(OS)' == 'Windows_NT' and '$(DesignTimeBuild)' != 'true'">true</OmsiDxilEnabled>
    <OmsiDxilEnabled Condition="'$(OmsiDxilEnabled)' == ''">false</OmsiDxilEnabled>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Shaders/Terrain.metal"
                      LogicalName="Nymeria.OMSI.Shaders.Terrain.metal" />
    <EmbeddedResource Include="Shaders/Scenery.metal"
                      LogicalName="Nymeria.OMSI.Shaders.Scenery.metal" />
  </ItemGroup>

  <!-- Generated bytecode lives under the intermediate output directory and is never
       committed. -->
  <ItemGroup Condition="'$(OmsiDxilEnabled)' == 'true'">
    <EmbeddedResource Include="$(OmsiDxilOutputDirectory)/Terrain.vert.dxil"
                      LogicalName="Nymeria.OMSI.Shaders.Terrain.vert.dxil" />
    <EmbeddedResource Include="$(OmsiDxilOutputDirectory)/Terrain.frag.dxil"
                      LogicalName="Nymeria.OMSI.Shaders.Terrain.frag.dxil" />
    <OmsiHlslShader Include="Shaders/Terrain.hlsl"
                    Profile="vs_6_0"
                    EntryPoint="VSMain"
                    OutputName="Terrain.vert.dxil" />
    <OmsiHlslShader Include="Shaders/Terrain.hlsl"
                    Profile="ps_6_0"
                    EntryPoint="PSMain"
                    OutputName="Terrain.frag.dxil" />
    <EmbeddedResource Include="$(OmsiDxilOutputDirectory)/Scenery.vert.dxil"
                      LogicalName="Nymeria.OMSI.Shaders.Scenery.vert.dxil" />
    <EmbeddedResource Include="$(OmsiDxilOutputDirectory)/Scenery.frag.dxil"
                      LogicalName="Nymeria.OMSI.Shaders.Scenery.frag.dxil" />
    <OmsiHlslShader Include="Shaders/Scenery.hlsl"
                    Profile="vs_6_0"
                    EntryPoint="VSMain"
                    OutputName="Scenery.vert.dxil" />
    <OmsiHlslShader Include="Shaders/Scenery.hlsl"
                    Profile="ps_6_0"
                    EntryPoint="PSMain"
                    OutputName="Scenery.frag.dxil" />
  </ItemGroup>

  <Import Project="Shaders/DxilShaders.targets" />

</Project>
